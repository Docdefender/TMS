            <span class="admin-section-icon">
                <i class="bi bi-building"></i>
            </span>

            <div>
                <h2>Silinmiş Departmanlar</h2>
                <p>Master data içerisinden kaldırılan departman kayıtları</p>
            </div>

        </div>


        @if (Model.DeletedDepartments.Any())
