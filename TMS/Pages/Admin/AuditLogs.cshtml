@page
@model TMS.Pages.Admin.AuditLogsModel
@{
    ViewData["Title"] = "Denetim Kayıtları";
}

<h1 class="page-heading"><i class="bi bi-journal-text mr-2"></i>Denetim Kayıtları</h1>

@if (!Model.Logs.Any())
{
    <div class="empty-state">
        <i class="bi bi-journal-x"></i>
        <h5 class="text-xl font-semibold mb-2">Henüz denetim kaydı yok</h5>
        <p class="mb-0">İşlemler gerçekleştikçe kayıtlar burada görünecektir.</p>
    </div>
}
else
{
    <div class="table-container">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Zaman</th>
                    <th>İşlem</th>
                    <th>Varlık</th>
                    <th>Varlık ID</th>
                    <th>Kullanıcı</th>
                    <th>Detaylar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr>
                        <td class="text-xs" style="color: var(--text-muted);">
                            @log.Timestamp.ToString("dd.MM.yyyy HH:mm")
                        </td>
                        <td>
                            <span class="badge @GetActionBadge(log.Action)">
                                <i class="bi @GetActionIcon(log.Action)"></i>
                                @GetActionText(log.Action)
                            </span>
                        </td>
                        <td class="text-sm">@GetEntityText(log.EntityType)</td>
                        <td class="text-sm">#@log.EntityId</td>
                        <td class="text-sm">@(log.User?.FullName ?? log.UserId ?? "-")</td>
                        <td class="text-xs" style="color: var(--text-muted);">@log.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    string GetActionBadge(string action) => action switch
    {
        "Created"       => "badge-created",
        "Updated"       => "badge-updated",
        "Deleted"       => "badge-deleted",
        "SoftDelete"    => "badge-softdelete",
        "Restored"      => "badge-restored",
        "StatusChanged" => "badge-statuschanged",
        "Login"         => "badge-login",
        "Logout"        => "badge-logout",
        "Register"      => "badge-register",
        "FileUploaded"  => "badge-fileuploaded",
        "FileDeleted"   => "badge-filedeleted",
        _               => "badge-default"
    };

    string GetActionIcon(string action) => action switch
    {
        "Created"       => "bi-plus-circle",
        "Updated"       => "bi-pencil",
        "Deleted"       => "bi-trash",
        "SoftDelete"    => "bi-trash",
        "Restored"      => "bi-arrow-counterclockwise",
        "StatusChanged" => "bi-arrow-left-right",
        "Login"         => "bi-box-arrow-in-right",
        "Logout"        => "bi-box-arrow-left",
        "Register"      => "bi-person-plus",
        "FileUploaded"  => "bi-paperclip",
        "FileDeleted"   => "bi-file-earmark-x",
        _               => "bi-dot"
    };

    string GetActionText(string action) => action switch
    {
        "Created"       => "Oluşturuldu",
        "Updated"       => "Güncellendi",
        "Deleted"       => "Silindi",
        "SoftDelete"    => "Silindi",
        "Restored"      => "Kurtarıldı",
        "StatusChanged" => "Durum Değişti",
        "Login"         => "Giriş",
        "Logout"        => "Çıkış",
        "Register"      => "Kayıt",
        "FileUploaded"  => "Dosya Yüklendi",
        "FileDeleted"   => "Dosya Silindi",
        _               => action
    };

    string GetEntityText(string entity) => entity switch
    {
        "Project"     => "Proje",
        "TaskItem"    => "Görev",
        "Comment"     => "Yorum",
        "Department"  => "Departman",
        "Category"    => "Kategori",
        "Attachment"  => "Dosya",
        "User"        => "Kullanıcı",
        _             => entity
    };
}
