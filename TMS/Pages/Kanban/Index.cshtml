@page
@model TMS.Pages.Kanban.IndexModel
@{
    ViewData["Title"] = "Kanban Tahtası";
}

<div class="flex items-center justify-between mb-6">
    <h1 class="page-heading"><i class="bi bi-kanban mr-2"></i>Kanban Tahtası</h1>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    @{
        var columns = new[]
        {
            ("NotStarted", "Başlamadı",    "#475569", Model.NotStartedProjects),
            ("InProgress", "Devam Ediyor", "#0D9488", Model.InProgressProjects),
            ("Completed",  "Tamamlandı",   "#16a34a", Model.CompletedProjects),
            ("OnHold",     "Beklemede",    "#d97706", Model.OnHoldProjects),
            ("Cancelled",  "İptal Edildi", "#A91101", Model.CancelledProjects),
        };
    }

    @foreach (var (statusValue, label, color, projects) in columns)
    {
        <div class="flex flex-col gap-2">
            <!-- Column Header -->
            <div class="flex items-center justify-between px-3 py-2 rounded-lg font-semibold text-sm text-white"
                 style="background: @color;">
                <span>@label</span>
                <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-white/20" id="counter-@statusValue">
                    @projects.Count
                </span>
            </div>

            <!-- Cards -->
            <div class="kanban-column flex flex-col gap-2 rounded-lg p-2 min-h-64"
                 data-status="@statusValue"
                 data-color="@color"
                 style="background: var(--bg-badge); border: 1px solid var(--border-color);">

                @foreach (var project in projects)
                {
                    var now = DateTime.Today;
                    var isOverdue = project.EndDate.HasValue
                        && project.EndDate.Value < now
                        && project.Status != TMS.Models.ProjectStatus.Completed
                        && project.Status != TMS.Models.ProjectStatus.Cancelled;
                    var isDueSoon = !isOverdue
                        && project.EndDate.HasValue
                        && project.EndDate.Value <= now.AddDays(7);

                    var taskCount = project.Tasks.Count;
                    var doneCount = project.Tasks.Count(t => t.Status == TMS.Models.TaskStatus.Done);
                    var members   = project.Members.Take(4).ToList();
                    var extraMembers = project.Members.Count - 4;
                    var cardBorderColor = isOverdue ? "#A91101" : color;

                    <div class="card cursor-grab hover:shadow-md transition-shadow kanban-card"
                         data-id="@project.Id"
                         data-status="@statusValue"
                         style="border-left: 6px solid @cardBorderColor; padding: 0.75rem;">

                        <!-- Title + badge -->
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <a asp-page="/Projects/Details" asp-route-id="@project.Id"
                               class="text-sm font-semibold leading-snug hover:underline"
                               style="color: var(--text-heading);">
                                @project.Name
                            </a>
                            @if (isOverdue)
                            {
                                <span class="badge badge-cancelled flex-shrink-0 text-xs">Gecikti</span>
                            }
                            else if (isDueSoon)
                            {
                                <span class="badge badge-onhold flex-shrink-0 text-xs">Yakında</span>
                            }
                        </div>

                        <!-- Department -->
                        @if (project.Department is not null)
                        {
                            <div class="text-xs mb-1" style="color: var(--text-muted);">
                                <i class="bi bi-building mr-1"></i>@project.Department.Name
                            </div>
                        }

                        <!-- Manager -->
                        @if (project.Manager is not null)
                        {
                            <div class="text-xs mb-2" style="color: var(--text-muted);">
                                <i class="bi bi-person-badge mr-1"></i>@project.Manager.FullName
                            </div>
                        }

                        <!-- Task progress -->
                        <div class="mb-2">
                            <div class="flex justify-between text-xs mb-1" style="color: var(--text-muted);">
                                <span><i class="bi bi-list-task mr-1"></i>Görevler</span>
                                <span>@doneCount/@taskCount</span>
                            </div>
                            @if (taskCount > 0)
                            {
                                var pct = (int)((doneCount * 100.0) / taskCount);
                                <div class="w-full rounded-full h-1.5 overflow-hidden" style="background: var(--border-color);">
                                    <div class="h-1.5 rounded-full transition-all"
                                         style="width: @pct%; background: #16a34a;"></div>
                                </div>
                            }
                        </div>

                        <!-- Team members + due date -->
                        <div class="flex items-center justify-between mt-2">
                            <div class="flex -space-x-2">
                                @foreach (var member in members)
                                {
                                    var initials = member.User?.FullName?.Length > 0
                                        ? member.User.FullName.Substring(0, Math.Min(2, member.User.FullName.Length)).ToUpper()
                                        : "?";
                                    <div class="w-6 h-6 rounded-full text-white text-xs flex items-center justify-center font-bold flex-shrink-0"
                                         style="background: @color; outline: 2px solid var(--bg-card);"
                                         title="@member.User?.FullName">
                                        @initials
                                    </div>
                                }
                                @if (extraMembers > 0)
                                {
                                    <div class="w-6 h-6 rounded-full text-xs flex items-center justify-center font-bold flex-shrink-0"
                                         style="background: var(--border-color); color: var(--text-muted); outline: 2px solid var(--bg-card);">
                                        +@extraMembers
                                    </div>
                                }
                            </div>

                            @if (project.EndDate.HasValue)
                            {
                                <span class="text-xs" style="color: @(isOverdue ? "#A91101" : "var(--text-muted)");">
                                    <i class="bi bi-calendar-event mr-1"></i>@project.EndDate.Value.ToString("dd.MM.yyyy")
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        // Hex values — CSS variables don't resolve in JS inline style assignments
        const statusColors = {
            'NotStarted': '#475569',
            'InProgress': '#0D9488',
            'Completed':  '#16a34a',
            'OnHold':     '#d97706',
            'Cancelled':  '#A91101',
        };
        const statusLabels = {
            'NotStarted': 'Başlamadı',
            'InProgress': 'Devam Ediyor',
            'Completed':  'Tamamlandı',
            'OnHold':     'Beklemede',
            'Cancelled':  'İptal Edildi',
        };

        document.querySelectorAll('.kanban-column').forEach(function (column) {
            new Sortable(column, {
                group: 'kanban',
                animation: 150,
                ghostClass: 'opacity-40',
                onEnd: function (evt) {
                    var projectId = parseInt(evt.item.dataset.id);
                    var newStatus = evt.to.dataset.status;
                    var oldStatus = evt.from.dataset.status;
                    if (newStatus === oldStatus) return;

                    // Update card left border color
                    evt.item.style.borderLeftColor = statusColors[newStatus];
                    evt.item.dataset.status = newStatus;

                    // Update member avatar colors inside the moved card
                    evt.item.querySelectorAll('.member-avatar').forEach(function (av) {
                        av.style.background = statusColors[newStatus];
                    });

                    // Update column counters
                    var oldCounter = document.getElementById('counter-' + oldStatus);
                    var newCounter = document.getElementById('counter-' + newStatus);
                    if (oldCounter) oldCounter.textContent = Math.max(0, parseInt(oldCounter.textContent) - 1);
                    if (newCounter) newCounter.textContent = parseInt(newCounter.textContent) + 1;

                    // Persist via AJAX
                    fetch('?handler=UpdateStatus', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken':
                                document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''
                        },
                        body: JSON.stringify({ projectId: projectId, newStatus: newStatus })
                    })
                    .then(r => r.json())
                    .then(data => { if (!data.success) location.reload(); })
                    .catch(() => location.reload());
                }
            });
        });
    </script>
    @Html.AntiForgeryToken()
}
