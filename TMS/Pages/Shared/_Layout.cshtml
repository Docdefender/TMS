@using Microsoft.Extensions.Localization
@using TMS.Resources
@inject IStringLocalizer<SharedResources> Localizer
<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dizge</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <script>
        (function () {
            var t = localStorage.getItem('dizge-theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
</head>
<body>
    <a href="#main-content" class="skip-to-content">Ana içeriğe geç</a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="flex" id="wrapper">
            <!-- Mobile overlay -->
            <div id="sidebarOverlay"></div>

            <!-- SIDEBAR -->
            <nav id="sidebar"
                 class="sidebar w-60 fixed top-0 left-0 h-screen flex flex-col z-40 overflow-x-hidden overflow-y-auto"
                 role="navigation" aria-label="Ana navigasyon">

                <!-- Header -->
                <div class="flex items-center justify-between px-3 py-4"
                     style="border-bottom: 1px solid var(--border-sidebar);">
                    <div class="flex items-center min-w-0">
                        <img src="~/favicon.png" alt="Dizge"
                             class="w-8 h-8 rounded object-contain flex-shrink-0" />
                        <span class="sidebar-brand text-white text-lg font-bold ml-2 truncate">Dizge</span>
                    </div>
                    <button id="sidebarToggle" type="button" aria-label="Menüyü Aç/Kapat"
                            class="flex-shrink-0 ml-1 p-1.5 rounded-md hover:bg-white/10 focus:outline-none transition-colors"
                            style="color: var(--text-sidebar-muted);">
                        <i class="bi bi-list text-xl"></i>
                    </button>
                </div>

                <!-- Nav Links -->
                <div class="flex-1 px-2 py-3 space-y-0.5">
                    <a class="sidebar-link" asp-page="/Index">
                        <i class="bi bi-speedometer2 flex-shrink-0 w-5 text-center"></i>
                        <span class="sidebar-text ml-2">Kontrol Paneli</span>
                    </a>
                    <a class="sidebar-link" asp-page="/Projects/Index">
                        <i class="bi bi-folder2-open flex-shrink-0 w-5 text-center"></i>
                        <span class="sidebar-text ml-2">Projeler</span>
                    </a>
                    <a class="sidebar-link" asp-page="/Tasks/Index">
                        <i class="bi bi-list-task flex-shrink-0 w-5 text-center"></i>
                        <span class="sidebar-text ml-2">Görevler</span>
                    </a>
                    <a class="sidebar-link" asp-page="/Kanban/Index">
                        <i class="bi bi-kanban flex-shrink-0 w-5 text-center"></i>
                        <span class="sidebar-text ml-2">Kanban</span>
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="section-heading sidebar-text ml-1 mt-4 mb-1"
                             style="border-color: var(--border-sidebar); color: var(--text-sidebar-muted);">
                            YÖNETİM
                        </div>
                        <a class="sidebar-link" asp-page="/Admin/Departments">
                            <i class="bi bi-building flex-shrink-0 w-5 text-center"></i>
                            <span class="sidebar-text ml-2">Departmanlar</span>
                        </a>
                        <a class="sidebar-link" asp-page="/Admin/Categories">
                            <i class="bi bi-tags flex-shrink-0 w-5 text-center"></i>
                            <span class="sidebar-text ml-2">Kategoriler</span>
                        </a>
                        <a class="sidebar-link" asp-page="/Admin/RecycleBin">
                            <i class="bi bi-trash flex-shrink-0 w-5 text-center"></i>
                            <span class="sidebar-text ml-2">Geri Dönüşüm Kutusu</span>
                        </a>
                        <a class="sidebar-link" asp-page="/Admin/Users">
                            <i class="bi bi-people flex-shrink-0 w-5 text-center"></i>
                            <span class="sidebar-text ml-2">Kullanıcılar</span>
                        </a>
                        <a class="sidebar-link" asp-page="/Admin/AuditLogs">
                            <i class="bi bi-journal-text flex-shrink-0 w-5 text-center"></i>
                            <span class="sidebar-text ml-2">Denetim Günlüğü</span>
                        </a>
                    }
                </div>

                <!-- Alt: Tema + Profil + Cikis -->
                <div class="px-2 py-3 space-y-1" style="border-top: 1px solid var(--border-sidebar);">

                    <!-- Tema Toggle -->
                    <button id="themeToggle" type="button" class="theme-toggle w-full" aria-label="Tema değiştir">
                        <div class="theme-switch" aria-hidden="true">
                            <div class="theme-switch-track"></div>
                            <div class="theme-switch-thumb" id="themeThumb">&#9728;&#65039;</div>
                        </div>
                        <span class="sidebar-text theme-label text-sm" id="themeLabel"
                              style="color: var(--text-sidebar);">Açık Tema</span>
                    </button>

                    <!-- Profil -->
                    <a class="sidebar-link" asp-page="/Account/Profile">
                        <i class="bi bi-person-circle flex-shrink-0 w-5 text-center"></i>
                        <span class="sidebar-text ml-2 text-sm truncate">@User.Identity?.Name</span>
                    </a>

                    <!-- Cikis -->
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="sidebar-link w-full text-left"
                                style="color: var(--text-sidebar-muted);">
                            <i class="bi bi-box-arrow-left flex-shrink-0 w-5 text-center"></i>
                            <span class="sidebar-text ml-2 text-sm">Çıkış Yap</span>
                        </button>
                    </form>
                </div>
            </nav>

            <!-- MAIN CONTENT -->
            <div id="page-content" class="flex flex-col min-w-0">
                <!-- Topbar -->
                <nav class="px-5 py-3 flex items-center gap-3 sticky top-0 z-30"
                     style="background: var(--bg-card); border-bottom: 1px solid var(--border-card);"
                     aria-label="Üst çubuk">
                    <!-- Mobil hamburger -->
                    <button id="mobileMenuBtn" type="button" aria-label="Menü"
                            class="hidden p-2 rounded-lg transition-colors"
                            style="color: var(--text-muted);">
                        <i class="bi bi-list text-xl"></i>
                    </button>
                </nav>

                <main class="p-5 flex-1" id="main-content" role="main">
                    @RenderBody()
                </main>

                <footer class="px-5 py-3 text-xs"
                        style="border-top: 1px solid var(--border-color); color: var(--text-muted);">
                    &copy; 2026 - Dizge
                </footer>
            </div>
        </div>
    }
    else
    {
        <div class="min-h-screen flex items-center justify-center p-4">
            <main id="main-content">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
