@using Microsoft.Extensions.Localization
@using TMS.Resources
@inject IStringLocalizer<SharedResources> Localizer
@inject Microsoft.AspNetCore.Identity.UserManager<TMS.Models.ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="tr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dizge</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />
    <script>
        (function () {
            var t = localStorage.getItem('dizge-theme') || 'light';
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>
</head>
<body>
    <a href="#main-content" class="skip-to-content">Ana içeriğe geç</a>

    @if (User.Identity?.IsAuthenticated == true)
    {
        var signedInUser = await UserManager.GetUserAsync(User);
        var currentPath = Context.Request.Path.Value ?? string.Empty;
        var isProjectWorkspace = currentPath.StartsWith("/Projects", StringComparison.OrdinalIgnoreCase)
            || currentPath.Equals("/Kanban/Projects", StringComparison.OrdinalIgnoreCase);
        var isTicketWorkspace = currentPath.StartsWith("/Tickets", StringComparison.OrdinalIgnoreCase);
        var isPipelineWorkspace = currentPath.StartsWith("/Pipeline", StringComparison.OrdinalIgnoreCase);
        var isTaskWorkspace = currentPath.StartsWith("/Tasks", StringComparison.OrdinalIgnoreCase)
            || currentPath.Equals("/Kanban", StringComparison.OrdinalIgnoreCase);
        var isAdminWorkspace = currentPath.StartsWith("/Admin", StringComparison.OrdinalIgnoreCase);
        var isAuditWorkspace = currentPath.Equals("/Admin/AuditLogs", StringComparison.OrdinalIgnoreCase);
        var searchPage = isTicketWorkspace ? "/Tickets/Index"
            : isProjectWorkspace || isPipelineWorkspace ? "/Projects/Index"
            : isAuditWorkspace ? "/Admin/AuditLogs"
            : isAdminWorkspace ? "/Admin/Users" : "/Tasks/Index";
        var searchName = isTicketWorkspace ? "search" : "Search";
        var searchPlaceholder = isTicketWorkspace ? "Ticket no, konu veya kişi ara..."
            : isProjectWorkspace || isPipelineWorkspace ? "Proje ara..."
            : isAuditWorkspace ? "Denetim kaydı ara..."
            : isAdminWorkspace ? "Kullanıcı ara..." : "Görev ara...";
        var liveSearchScope = isTicketWorkspace ? "tickets"
            : isProjectWorkspace || isPipelineWorkspace ? "projects"
            : isTaskWorkspace ? "tasks"
            : !isAdminWorkspace ? "all" : null;
        var roleLabel = User.IsInRole("Admin") ? "Admin"
            : User.IsInRole("Manager") ? "Manager" : "Kullanıcı";
        var displayName = signedInUser?.FullName ?? User.Identity?.Name ?? "Kullanıcı";

        <div id="wrapper">
            <!-- Mobile overlay -->
            <div id="sidebarOverlay"></div>

            <!-- SIDEBAR -->
            <nav id="sidebar"
                 class="sidebar"
                 role="navigation" aria-label="Ana navigasyon">

                <!-- Sidebar Brand -->
                <div class="sidebar-header">
                    <a asp-page="/Index" class="sidebar-logo-link" aria-label="Dizge ana sayfa">
                        <div class="sidebar-logo-mark">
                            <img src="~/images/dizge-mark.svg"
                                 alt=""
                                 class="sidebar-logo-image" />
                        </div>

                        <div class="sidebar-brand-wrap sidebar-text">
                            <span class="sidebar-brand">Dizge</span>
                            <span class="sidebar-brand-subtitle">Sistemleri Birleştirir</span>
                        </div>
                    </a>

                    <button id="sidebarToggle"
                            type="button"
                            aria-label="Menüyü Aç/Kapat"
                            title="Menüyü daralt"
                            class="sidebar-collapse-btn">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                </div>

                <!-- Nav Links -->
                <div class="sidebar-nav">
                    <a class="sidebar-link" asp-page="/Index">
                        <i class="bi bi-speedometer2"></i>
                        <span class="sidebar-text">Kontrol Paneli</span>
                    </a>
                    <a class="sidebar-link" asp-page="/Projects/Index" data-sidebar-section="projects">
                        <i class="bi bi-folder2-open"></i>
                        <span class="sidebar-text">Projeler</span>
                    </a>
                    <a class="sidebar-link" asp-page="/Tasks/Index" data-sidebar-section="tasks">
                        <i class="bi bi-list-task"></i>
                        <span class="sidebar-text">Görevler</span>
                    </a>
                    <a class="sidebar-link" asp-page="/Tickets/Index">
                        <i class="bi bi-inbox"></i>
                        <span class="sidebar-text">Ticket'lar</span>
                    </a>
                    <a class="sidebar-link" asp-page="/Reports/Index">
                        <i class="bi bi-bar-chart-line"></i>
                        <span class="sidebar-text">Raporlar</span>
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="section-heading sidebar-text">
                            YÖNETİM
                        </div>
                        <a class="sidebar-link" asp-page="/Admin/Departments">
                            <i class="bi bi-building"></i>
                            <span class="sidebar-text">Departmanlar</span>
                        </a>
                        <a class="sidebar-link" asp-page="/Admin/Categories">
                            <i class="bi bi-tags"></i>
                            <span class="sidebar-text">Kategoriler</span>
                        </a>
                        <a class="sidebar-link" asp-page="/Admin/RecycleBin">
                            <i class="bi bi-trash"></i>
                            <span class="sidebar-text">Geri Dönüşüm Kutusu</span>
                        </a>
                        <a class="sidebar-link" asp-page="/Admin/Users">
                            <i class="bi bi-people"></i>
                            <span class="sidebar-text">Kullanıcılar</span>
                        </a>
                        <a class="sidebar-link" asp-page="/Admin/AuditLogs">
                            <i class="bi bi-journal-text"></i>
                            <span class="sidebar-text">Denetim Günlüğü</span>
                        </a>
                    }
                </div>

            </nav>

            <!-- MAIN CONTENT -->
            <div id="page-content">
                <header class="app-topbar" aria-label="Üst çubuk">
                    <div class="topbar-left">
                        <button id="mobileMenuBtn"
                                type="button"
                                aria-label="Menü"
                                class="topbar-icon-btn mobile-menu-btn">
                            <i class="bi bi-list"></i>
                        </button>
                        <form method="get" asp-page="@searchPage" class="topbar-search" role="search"
                              data-topbar-search
                              data-search-scope="@liveSearchScope"
                              data-suggestions-url="@Url.Page("/Search", "Suggestions")">
                            <i class="bi bi-search"></i>
                            <input type="search"
                                   name="@searchName"
                                   placeholder="@searchPlaceholder"
                                   autocomplete="off"
                                   aria-label="@searchPlaceholder" />
                        </form>
                    </div>

                    <div class="topbar-right">
                        <button id="themeToggle" type="button" class="topbar-icon-btn" aria-label="Tema değiştir" title="Tema değiştir">
                            <i class="bi bi-sun theme-icon-sun" aria-hidden="true"></i>
                            <i class="bi bi-moon-stars theme-icon-moon" aria-hidden="true"></i>
                        </button>

                        @await Component.InvokeAsync("NotificationMenu")

                        <div class="topbar-profile" data-profile-menu>
                            <button type="button"
                                    class="topbar-account-button"
                                    aria-label="Profil menüsünü aç"
                                    aria-haspopup="true"
                                    aria-expanded="false"
                                    data-profile-menu-toggle
                                    title="@displayName">
                            @{
                                var username = User.Identity?.Name ?? "U";
                                var initial = username.Length > 0
                                ? username.Substring(0, 1).ToUpperInvariant()
                                : "U";
                            }
                                <span class="topbar-avatar">
                                    @if (!string.IsNullOrWhiteSpace(signedInUser?.ProfileImagePath))
                                    {
                                        <img src="@signedInUser.ProfileImagePath" alt="" />
                                    }
                                    else
                                    {
                                        @initial
                                    }
                                </span>
                                <span class="topbar-account-copy">
                                    <strong>@displayName</strong>
                                    <small>@roleLabel</small>
                                </span>
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                            <div class="topbar-profile-menu" data-profile-menu-panel hidden>
                                <div class="topbar-profile-identity">
                                    <span class="topbar-menu-avatar">
                                        @if (!string.IsNullOrWhiteSpace(signedInUser?.ProfileImagePath))
                                        {
                                            <img src="@signedInUser.ProfileImagePath" alt="" />
                                        }
                                        else
                                        {
                                            @initial
                                        }
                                    </span>
                                    <div>
                                        <strong>@displayName</strong>
                                        <small>@roleLabel · Hesap seçenekleri</small>
                                    </div>
                                </div>
                                <a asp-page="/Account/Profile">
                                    <i class="bi bi-person"></i>
                                    Profil
                                </a>
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit">
                                        <i class="bi bi-box-arrow-right"></i>
                                        Çıkış Yap
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </header>

                <main class="app-main" id="main-content" role="main">
                    @RenderBody()
                </main>

            </div>
        </div>
    }
    else
    {
        <div class="guest-shell">
            <main id="main-content">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/record-preview.js" asp-append-version="true"></script>
    <script src="~/js/topbar-search.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
